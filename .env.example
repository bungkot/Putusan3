# Indonesian Proxy Scraper Environment Configuration
# Copy this file to .env and modify as needed
# NOTE: python-dotenv is wired up in config.py, so a .env file IS loaded.

# Target URLs to scrape (comma-separated)
TARGET_URLS=https://httpbin.org/ip,https://httpbin.org/headers,https://httpbin.org/user-agent

# Proxy settings
PROXY_REFRESH_INTERVAL=300          # Seconds between proxy list refresh
MIN_POOL_SIZE=5                     # Refresh the pool when healthy proxies drop below this
MAX_CONCURRENT=3                    # Parallel browser contexts / validation workers
REQUEST_TIMEOUT=60000               # Playwright page timeout in milliseconds

# Proxy validation
VALIDATION_TIMEOUT=15000            # Validation timeout in milliseconds
VALIDATION_TEST_URL=http://httpbin.org/get    # /get echoes headers (needed for anonymity check); http:// — free proxies are mostly http-only
MAX_PROXY_FAILURES=3                # Retire proxy after N consecutive failures
SOURCE_FETCH_TIMEOUT=15.0           # Timeout fetching proxy-source LISTS (seconds)

# Indonesian proxy filtering
INDONESIAN_COUNTRY_CODE=ID          # Country code for GeoIP filtering
USE_GEOIP_FILTER=true               # Use GeoIP (ip-api.com) to verify Indonesian IPs

# Browser settings
HEADLESS=true                       # Run headless (false for debugging)
BROWSER_TYPE=chromium               # chromium, firefox, or webkit

# Rate limiting (seconds between requests)
MIN_DELAY=2.0
MAX_DELAY=10.0

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1.0

# Logging
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR

# Results export (optional). .json appends to a JSON array; .csv appends rows.
# RESULTS_PATH=results.json

# Proxy pool snapshots (plain text, one ip:port per line)
# PROXY_SAVE_PATH=proxy_pool.txt    # auto-saved after every refresh
# PROXY_LOAD_PATH=proxy_pool.txt    # restores pool at startup instead of fetching

# Proxy sources (optional, comma- or newline-separated).
# Overrides the defaults in config.py entirely when set.
# PROXY_SOURCES=https://api.proxyscrape.com/v2/?request=displayproxies&protocol=http&timeout=10000&country=ID&ssl=all&anonymity=all
